# ==========================================================
# stance — 환경변수 템플릿
#
# 사용법:
#   1) 이 파일을 복사해서 .env 로 이름을 바꾼다
#        cp .env.example .env
#   2) 각 값을 실제 키로 채운다
#   3) .env 는 절대 커밋하지 않는다 (.gitignore 처리)
# ==========================================================


# ─────────── 공공데이터포털 (데이터 수집) ───────────
# 발급: <https://www.data.go.kr> → 마이페이지 → 오픈API → 개발계정
#
# 활용신청 대상 2건 (둘 다 같은 키를 씀):
#   · 국토교통부_아파트 매매 실거래가 상세 자료
#   · 국토교통부_아파트 전월세 실거래가 자료
#
# 반드시 "디코딩" 서비스키를 넣을 것.
#   포털은 인코딩/디코딩 두 벌을 준다. 스크립트가 urlencode()로 조립하므로
#   인코딩 키를 넣으면 이중 인코딩되어 에러 30(등록되지 않은 서비스키)이 난다.
#   판별법: 값에 % 기호가 있으면 인코딩 키다.
#
# 일 한도 10,000건 / 초당 30 tps / 개발계정 자동승인
DATA_GO_KR_KEY=


# ─────────── 브이월드 Geocoder (좌표 결손 보완) ───────────
# 발급: <https://www.vworld.kr> → 오픈API → 인증키 발급
# 용도: 서울시 공동주택 CSV에 좌표가 없는 단지만 활용
# 일 4만건 한도. 개발계정 인증키는 6개월 유효
VWORLD_KEY=


# ─────────── Supabase ───────────
# 발급: <https://supabase.com> → 프로젝트 → Settings → API
#
# NEXT_PUBLIC_ 접두사는 "브라우저에 노출된다"는 뜻이다.
# anon key는 노출을 전제로 설계된 키이며 RLS(Row Level Security)로 보호된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 아래 키는 '서버 전용' - 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것. 
# service_role 키는 RLS를 무시한다. 
# 접두사 붙이면 브라우저에 키가 노출되어 사용자의 개별 기록이 읽힐 수 있으므로 주의.
# 수집 배치, Route Handler에서만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=


# ─────────── Sentry ───────────
# 발급: <https://sentry.io> → 프로젝트 생성 → Client Keys
# 용도: 예산 계산 완성 시점에 에러 예상되어 도입
NEXT_PUBLIC_SENTRY_DSN=

# 용도: 소스맵 업로드용. 배포 파이프라인에서만 사용
SENTRY_AUTH_TOKEN=